MCP_ENVIRONMENT=development
MCP_RESOURCE_URL=http://fitness-mcp-service:8001/mcp
# Inject a high-entropy token separately into Agent. Store only its SHA-256 here.
# Record: {"principal":"fitness-agent","sha256":"<64 lower hex>","resource":"http://fitness-mcp-service:8001/mcp","scopes":["fitness:read","fitness:write"],"expires_at":<unix seconds>}
MCP_SERVICE_CREDENTIALS_JSON=[]
MCP_GATEWAY_BASE_URL=http://fitness-core-gateway:8080
MCP_GATEWAY_SERVICE_TOKEN=
MCP_ALLOWED_HOSTS=["fitness-mcp-service","fitness-mcp-service:*","localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
MCP_ALLOWED_ORIGINS=[]
MCP_CONTEXT_ALGORITHM=RS256
MCP_CONTEXT_PUBLIC_KEYS_JSON={}
MCP_CONTEXT_JWKS_URL=
MCP_CONTEXT_MAX_TTL_SECONDS=300
# HS256 is only available in development/test with an explicit opt-in.
MCP_ALLOW_INSECURE_HS256=false
MCP_CONTEXT_SECRET=
MCP_CONTEXT_KEY_ID=legacy
MCP_MAX_DEADLINE_SECONDS=10
MCP_CONNECT_TIMEOUT_SECONDS=2
MCP_MAX_REQUEST_BYTES=262144
MCP_MAX_RESULT_BYTES=1048576
MCP_MAX_CONCURRENT_GATEWAY_CALLS=100
MCP_PAGE_SIZE=20
