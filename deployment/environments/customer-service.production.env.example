CUSTOMER_SERVICE_DB_USERNAME=
CUSTOMER_SERVICE_DB_PASSWORD=
CUSTOMER_SERVICE_DB_MAX_POOL_SIZE=20
CUSTOMER_SERVICE_DB_CONNECTION_TIMEOUT_MS=3000
CUSTOMER_SERVICE_INTERNAL_SERVICE_TOKEN=
CUSTOMER_SERVICE_SCHEMA_INIT_ENABLED=false
