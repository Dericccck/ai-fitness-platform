# Fitness Core Gateway 生产配置模板
# 该文件只描述配置契约；真实值必须由部署平台 Secret/Config 注入，不能直接复制为生产 .env。
GATEWAY_SERVER_PORT=8081
GATEWAY_DB_URL=jdbc:mysql://mysql.internal:3306/fitness?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia%2FShanghai
GATEWAY_DB_USERNAME=
GATEWAY_DB_PASSWORD=
GATEWAY_DB_MAX_POOL_SIZE=20
GATEWAY_DB_CONNECTION_TIMEOUT_MS=3000

GATEWAY_INTERNAL_SERVICE_TOKEN=
GATEWAY_CONTEXT_SIGNING_ALGORITHM=RS256
GATEWAY_CONTEXT_SIGNING_KEY_ID=auth-context-v1
GATEWAY_CONTEXT_VERIFICATION_JWKS_URL=https://auth.internal.example/.well-known/jwks.json
GATEWAY_CONTEXT_VERIFICATION_JWKS_CACHE_SECONDS=300
GATEWAY_CONTEXT_VERIFICATION_JWKS_TIMEOUT_MS=2000
GATEWAY_MAX_CONTEXT_TTL_SECONDS=300

GATEWAY_CONFIRMATION_SIGNING_ALGORITHM=RS256
GATEWAY_CONFIRMATION_SIGNING_KEY_ID=fitness-confirmation-v1
GATEWAY_CONFIRMATION_VERIFICATION_JWKS_URL=https://auth.internal.example/.well-known/confirmation-jwks.json
GATEWAY_CONFIRMATION_VERIFICATION_JWKS_CACHE_SECONDS=300
GATEWAY_CONFIRMATION_VERIFICATION_JWKS_TIMEOUT_MS=2000

GATEWAY_TRAINING_SERVICE_BASE_URL=http://fitness-training-service:8082
GATEWAY_TRAINING_SERVICE_TOKEN=
GATEWAY_TRAINING_SERVICE_TIMEOUT_MS=5000
GATEWAY_BOOKING_SERVICE_BASE_URL=http://fitness-booking-service:8083
GATEWAY_BOOKING_SERVICE_TOKEN=
GATEWAY_BOOKING_SERVICE_TIMEOUT_MS=5000
GATEWAY_CUSTOMER_SERVICE_BASE_URL=http://fitness-customer-service:8084
GATEWAY_CUSTOMER_SERVICE_TOKEN=
GATEWAY_CUSTOMER_SERVICE_TIMEOUT_MS=5000

# 只接受独立主体凭证哈希；每个有效期为UNIX秒，由Secret Manager注入。
GATEWAY_ALLOW_LEGACY_SERVICE_TOKEN=false
GATEWAY_LEGACY_SERVICE_TOKEN_EXPIRES_AT=0
GATEWAY_MCP_EXECUTION_TOKEN_SHA256=
GATEWAY_MCP_EXECUTION_TOKEN_EXPIRES_AT=
GATEWAY_AGENT_EXECUTION_TOKEN_SHA256=
GATEWAY_AGENT_EXECUTION_TOKEN_EXPIRES_AT=
GATEWAY_AGENT_QUERY_TOKEN_SHA256=
GATEWAY_AGENT_QUERY_TOKEN_EXPIRES_AT=
GATEWAY_RECONCILIATION_TOKEN_SHA256=
GATEWAY_RECONCILIATION_TOKEN_EXPIRES_AT=
