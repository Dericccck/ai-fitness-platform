AGENT_ENVIRONMENT=local
AGENT_LOG_LEVEL=DEBUG
AGENT_API_DOCS_ENABLED=true
AGENT_METRICS_ENABLED=true
AGENT_OTEL_ENABLED=false
AGENT_OTEL_TRACE_SAMPLE_RATIO=1.0
