# Training Service 生产配置模板
# 训练服务使用独立 MySQL 写账号；数据库迁移由独立发布 Job 执行。
TRAINING_SERVER_PORT=8082
TRAINING_DB_URL=jdbc:mysql://mysql.internal:3306/fitness?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia%2FShanghai
TRAINING_DB_USERNAME=
TRAINING_DB_PASSWORD=
TRAINING_DB_MAX_POOL_SIZE=20
TRAINING_DB_CONNECTION_TIMEOUT_MS=3000

TRAINING_RABBITMQ_HOST=rabbitmq.internal
TRAINING_RABBITMQ_PORT=5672
TRAINING_RABBITMQ_USERNAME=
TRAINING_RABBITMQ_PASSWORD=
TRAINING_RABBITMQ_PUBLISHER_CONFIRMS=true
TRAINING_INTERNAL_SERVICE_TOKEN=
TRAINING_SCHEMA_INIT_ENABLED=false
TRAINING_OUTBOX_PUBLISHER_ENABLED=true
TRAINING_OUTBOX_FIXED_DELAY_MS=1000
TRAINING_OUTBOX_BATCH_SIZE=50
TRAINING_OUTBOX_MAX_ATTEMPTS=8
TRAINING_OUTBOX_CLAIM_LEASE_SECONDS=60
TRAINING_OUTBOX_RETRY_BASE_SECONDS=5
TRAINING_OUTBOX_CONFIRM_TIMEOUT_MS=5000
TRAINING_OUTBOX_EXCHANGE=fitness.domain.events
TRAINING_OUTBOX_ROUTING_KEY=training.plan.published
