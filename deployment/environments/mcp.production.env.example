# MCP服务独立Secret；不得使用Agent或Gateway的其他服务Token。
MCP_ENVIRONMENT=production
MCP_RESOURCE_URL=https://fitness-mcp.internal/mcp
MCP_GATEWAY_BASE_URL=http://gateway.internal:8081
MCP_GATEWAY_SERVICE_TOKEN=
# JSON数组，每项含principal/sha256/scopes/expires_at/resource；resource与上方地址精确一致。
MCP_SERVICE_CREDENTIALS_JSON=
MCP_ALLOWED_HOSTS=["fitness-mcp.internal","fitness-mcp.internal:443","127.0.0.1:8001"]
MCP_ALLOWED_ORIGINS=[]
MCP_CONTEXT_ALGORITHM=RS256
MCP_CONTEXT_KEY_ID=auth-context-v1
MCP_CONTEXT_JWKS_URL=https://auth.internal.example/.well-known/jwks.json
MCP_ALLOW_INSECURE_HS256=false
MCP_MAX_DEADLINE_SECONDS=10
MCP_MAX_REQUEST_BYTES=262144
MCP_MAX_RESULT_BYTES=1048576
MCP_MAX_CONCURRENT_GATEWAY_CALLS=100
