# 本地 TruLens 在线导出验收配置。不要把真实生产凭证写入此文件。
# 该配置对应 deployment/docker-compose.agent-infra.yml 中独立的 5434 端口数据库。
TRULENS_POSTGRES_DB=fitness_agent_eval
TRULENS_POSTGRES_USER=fitness_eval
TRULENS_POSTGRES_PASSWORD=fitness_eval_local
TRULENS_POSTGRES_PORT=5434

AGENT_OTEL_ENABLED=true
AGENT_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AGENT_OTEL_TRACE_SAMPLE_RATIO=1.0
AGENT_TRULENS_ENABLED=true
AGENT_TRULENS_CAPTURE_MODE=evaluation
AGENT_TRULENS_CAPTURE_MAX_CHARS=2000
AGENT_TRULENS_ONLINE_EXPORT_ENABLED=true
AGENT_TRULENS_RETENTION_DAYS=30
TRULENS_IDENTIFIER_HASH_SECRET=仅本地测试用的HMAC密钥请替换
TRULENS_DATABASE_URL=postgresql+psycopg://fitness_eval:fitness_eval_local@127.0.0.1:5434/fitness_agent_eval
