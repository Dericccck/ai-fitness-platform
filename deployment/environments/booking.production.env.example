# Booking Service 生产配置模板
# 预约写服务使用独立 MySQL 写账号；不能复用 Gateway 只读账号。
BOOKING_SERVER_PORT=8083
BOOKING_DB_URL=jdbc:mysql://mysql.internal:3306/fitness?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia%2FShanghai
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=
BOOKING_DB_MAX_POOL_SIZE=20
BOOKING_DB_CONNECTION_TIMEOUT_MS=3000

BOOKING_RABBITMQ_HOST=rabbitmq.internal
BOOKING_RABBITMQ_PORT=5672
BOOKING_RABBITMQ_USERNAME=
BOOKING_RABBITMQ_PASSWORD=
BOOKING_RABBITMQ_PUBLISHER_CONFIRMS=true
BOOKING_INTERNAL_SERVICE_TOKEN=
BOOKING_SCHEMA_INIT_ENABLED=false
BOOKING_OUTBOX_PUBLISHER_ENABLED=true
BOOKING_OUTBOX_FIXED_DELAY_MS=1000
BOOKING_OUTBOX_BATCH_SIZE=50
BOOKING_OUTBOX_MAX_ATTEMPTS=8
BOOKING_OUTBOX_CLAIM_LEASE_SECONDS=60
BOOKING_OUTBOX_RETRY_BASE_SECONDS=5
BOOKING_OUTBOX_CONFIRM_TIMEOUT_MS=5000
BOOKING_OUTBOX_EXCHANGE=fitness.domain.events
BOOKING_OUTBOX_QUEUE=fitness.booking.events
BOOKING_OUTBOX_ROUTING_KEY=appointment.created
