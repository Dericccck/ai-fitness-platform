        </encoder>
    </appender>
    <appender name="${channel.click}-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${FITNESS_LOG_PATH}/channel/click/fitness.%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <maxHistory>0</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="${article.view}" level="INFO">
        <appender-ref ref="${article.view}-FILE"/>
    </logger>
    <logger name="${organization.view}" level="INFO">
        <appender-ref ref="${organization.view}-FILE"/>
    </logger>
    <logger name="${works.view}" level="INFO">
        <appender-ref ref="${works.view}-FILE"/>
    </logger>
    <logger name="${activity.view}" level="INFO">
        <appender-ref ref="${activity.view}-FILE"/>
    </logger>
    <logger name="${frogRank.view}" level="INFO">
        <appender-ref ref="${frogRank.view}-FILE"/>
    </logger>
    <logger name="${item.view}" level="INFO">
        <appender-ref ref="${item.view}-FILE"/>
    </logger>
    <logger name="${device.setup}" level="INFO">
        <appender-ref ref="${device.setup}-FILE"/>
    </logger>
    <logger name="${device.login}" level="INFO">
        <appender-ref ref="${device.login}-FILE"/>
    </logger>
    <logger name="${marketing.response}" level="INFO">
