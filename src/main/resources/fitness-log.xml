            <fileNamePattern>
                ${FITNESS_LOG_PATH}/channel/view/fitness.%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <maxHistory>0</maxHistory>
        </rollingPolicy>
        <encoder>
