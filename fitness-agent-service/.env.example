# 复制为 .env 用于本地开发。切勿提交 .env。
AGENT_ENVIRONMENT=local
AGENT_HOST=0.0.0.0
AGENT_PORT=8090
AGENT_SERVICE_NAME=fitness-agent-service
AGENT_SERVICE_VERSION=0.1.0
AGENT_LOG_LEVEL=INFO
AGENT_API_DOCS_ENABLED=true

# 可观测性。提供明确的 Collector endpoint 前保持关闭 OTLP 导出。
AGENT_METRICS_ENABLED=true
AGENT_OTEL_ENABLED=false
AGENT_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AGENT_OTEL_EXPORT_TIMEOUT_SECONDS=10
AGENT_OTEL_TRACE_SAMPLE_RATIO=1.0

# TruLens 评估。普通本地请求保持关闭。`metadata` 发出路由/工具/Token 事实；
# `evaluation` 额外发出有界的脱敏文本，仅用于受限的预发布/评估环境。
AGENT_TRULENS_ENABLED=false
AGENT_TRULENS_CAPTURE_MODE=disabled
AGENT_TRULENS_CAPTURE_MAX_CHARS=2000
TRULENS_DATABASE_URL=sqlite:///./var/trulens/trulens.sqlite
TRULENS_JUDGE_ENABLED=false
TRULENS_JUDGE_BASE_URL=https://api.deepseek.com
TRULENS_JUDGE_API_KEY=
TRULENS_JUDGE_MODEL=deepseek-v4-flash
AGENT_TRULENS_JUDGE_TIMEOUT_SECONDS=30

# 可选的标准 OpenTelemetry 导出器请求头，通常作为 Secret 注入。
OTEL_EXPORTER_OTLP_HEADERS=

# Agent 持久化和 Checkpoint
AGENT_DATABASE_URL=postgresql+asyncpg://fitness_agent:fitness_agent@127.0.0.1:5433/fitness_agent
AGENT_REDIS_URL=redis://127.0.0.1:6380/0
AGENT_DB_POOL_SIZE=10
AGENT_DB_MAX_OVERFLOW=20
AGENT_CHECKPOINT_DATABASE_URL=
AGENT_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_CHECKPOINT_POOL_MAX_SIZE=5
AGENT_SESSION_LOCK_TTL_SECONDS=60

# 确认 Payload 加密。本地密钥生成命令：openssl rand -base64 32
# 生产环境必须使用 Secret Manager，并通过修改密钥版本进行轮换。
AGENT_CONFIRMATION_ENCRYPTION_KEY_BASE64=
AGENT_CONFIRMATION_ENCRYPTION_KEY_VERSION=local-v1
AGENT_CONFIRMATION_TTL_SECONDS=600
AGENT_CONFIRMATION_SIGNING_SECRET=
AGENT_CONFIRMATION_TOKEN_TTL_SECONDS=120
AGENT_CONFIRMATION_SIGNING_ALGORITHM=HS256
AGENT_CONFIRMATION_SIGNING_KEY_ID=legacy
# RS256 生产环境由 Secret Manager 注入 PEM 私钥；HMAC 模式保持为空。
AGENT_CONFIRMATION_SIGNING_PRIVATE_KEY_PEM=

# LLM 服务商：与 learning-langchain-CN 使用相同的 DeepSeek 变量。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_OUTPUT_TOKENS=1200
# 训练计划包含多天动作明细，使用独立输出预算，避免结构化 JSON 被截断。
AGENT_TRAINING_PLAN_MAX_OUTPUT_TOKENS=3000
AGENT_AGENT_MAX_TOOL_STEPS=4
AGENT_LLM_THINKING_ENABLED=false

# Embedding 支持本地 BGE-M3 模型或 OpenAI-compatible endpoint。
AGENT_EMBEDDING_BACKEND=local
AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=
AGENT_EMBEDDING_MODEL_PATH=/Users/a1-6/Desktop/AIAgent/models/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181
# 必须与知识库迁移中的向量维度一致。
AGENT_EMBEDDING_DIMENSIONS=1024

# Reranker 支持本地 BGE Cross-Encoder 或服务商专用 HTTP endpoint。
AGENT_RERANKER_BACKEND=local
AGENT_RERANKER_URL=
AGENT_RERANKER_API_KEY=
AGENT_RERANKER_MODEL=
AGENT_RERANKER_MODEL_PATH=/Users/a1-6/Desktop/AIAgent/models/models--BAAI--bge-reranker-base/snapshots/2cfc18c9415c912f9d8155881c133215df768a70
AGENT_RERANKER_TIMEOUT_SECONDS=15

# RAG 检索限制。请求不能覆盖这些生产环境边界。
AGENT_RAG_CANDIDATE_LIMIT=20
AGENT_RAG_KEYWORD_CANDIDATE_LIMIT=20
AGENT_RAG_TOP_K=5
AGENT_RAG_EMBEDDING_BATCH_SIZE=32
AGENT_RAG_CHUNK_MAX_CHARS=1200
AGENT_RAG_CHUNK_OVERLAP_CHARS=120
AGENT_RAG_VECTOR_WEIGHT=0.6
AGENT_RAG_KEYWORD_WEIGHT=0.4
AGENT_RAG_RRF_K=60
AGENT_RAG_MAX_SOURCE_BYTES=20971520
AGENT_RAG_STAGING_DIR=./var/rag-staging
AGENT_RAG_STORAGE_BACKEND=local
AGENT_RAG_S3_ENDPOINT_URL=http://127.0.0.1:9000
AGENT_RAG_S3_REGION=us-east-1
AGENT_RAG_S3_BUCKET=fitness-agent-knowledge
AGENT_RAG_S3_ACCESS_KEY=
AGENT_RAG_S3_SECRET_KEY=
AGENT_RAG_INGESTION_MAX_ATTEMPTS=3
AGENT_RAG_INGESTION_WORKER_BATCH_SIZE=10
AGENT_RAG_REINDEX_WORKER_BATCH_SIZE=2
AGENT_RAG_REINDEX_WORKER_POLL_SECONDS=2
AGENT_MEMORY_CANDIDATE_EXPIRY_BATCH_SIZE=500
AGENT_MEMORY_CANDIDATE_EXPIRY_POLL_SECONDS=60
AGENT_MEMORY_CANDIDATE_WORKER_METRICS_PORT=8092
AGENT_PROACTIVE_WORKER_ENABLED=false
AGENT_PROACTIVE_RABBITMQ_URL=amqp://fitness_agent:fitness_agent_secret@127.0.0.1:5672/
AGENT_PROACTIVE_RABBITMQ_EXCHANGE=fitness.domain.events
AGENT_PROACTIVE_RABBITMQ_QUEUE=fitness.proactive.events
AGENT_PROACTIVE_RABBITMQ_ROUTING_KEY=appointment.created,appointment.rescheduled,appointment.cancelled,training.plan.review_required,training.plan.published
# 仅用于主动提醒真实验收：通过指定容器内 mysql 客户端只读核对预约 Outbox。
BOOKING_DB_CONTAINER=fitness-mysql
BOOKING_DB_NAME=fitness
BOOKING_DB_USERNAME=fitness
BOOKING_DB_PASSWORD=
AGENT_PROACTIVE_WORKER_BATCH_SIZE=50
AGENT_PROACTIVE_WORKER_POLL_SECONDS=2
AGENT_PROACTIVE_WORKER_METRICS_PORT=8096
# 真实预约主动提醒验收只允许使用本地测试数据；不把具体业务标识提交到仓库。
# AGENT_PROACTIVE_BOOKING_LIVE_MESSAGE=请使用专门的本地测试数据创建一次预约
AGENT_MEMORY_TERMINAL_RETENTION_DAYS=90
AGENT_MEMORY_CANDIDATE_TERMINAL_RETENTION_DAYS=30
AGENT_MEMORY_RETENTION_BATCH_SIZE=500
AGENT_MEMORY_RETENTION_POLL_SECONDS=3600
AGENT_MEMORY_RETENTION_WORKER_METRICS_PORT=8094
AGENT_SESSION_SUMMARY_TRIGGER_MESSAGES=12
AGENT_SESSION_SUMMARY_KEEP_RECENT_MESSAGES=6
AGENT_SESSION_SUMMARY_MAX_CHARS=3000
AGENT_SESSION_SUMMARY_MAX_INPUT_CHARS=12000
AGENT_SESSION_SUMMARY_RETENTION_DAYS=7
AGENT_SESSION_SUMMARY_BATCH_SIZE=500
AGENT_SESSION_SUMMARY_POLL_SECONDS=3600
AGENT_SESSION_SUMMARY_WORKER_METRICS_PORT=8095
AGENT_RAG_PDF_MIN_IMAGE_AREA_RATIO=0.45
AGENT_RAG_PDF_MAX_IMAGE_PAGE_TEXT_CHARS=600
AGENT_RAG_PDF_MAX_IMAGE_PAGE_TEXT_AREA_RATIO=0.25
AGENT_RAG_PDF_MIN_OCR_TEXT_CHARS=12
AGENT_RAG_PDF_MIN_OCR_CONFIDENCE=0.75
AGENT_RAG_QUALITY_MAX_NOISE_RATE=0.0
AGENT_RAG_QUALITY_MAX_FRAGMENT_RATE=0.35
AGENT_RAG_QUALITY_MAX_DUPLICATE_RATE=0.02
AGENT_RAG_QUALITY_MIN_PARENT_INTEGRITY=1.0
AGENT_RAG_QUALITY_MIN_TABLE_INTEGRITY=1.0
AGENT_RAG_QUALITY_MAX_MISSING_PAGES=0
AGENT_RAG_QUALITY_MAX_OCR_REQUIRED_PAGES=0

# 文件安全和 OCR。结构检查仍是本地开发默认配置；
# 生产环境应使用 ClamAV 和独立 OCR 服务。
AGENT_RAG_MALWARE_SCANNER_BACKEND=structural
AGENT_RAG_CLAMAV_HOST=127.0.0.1
AGENT_RAG_CLAMAV_PORT=3310
AGENT_RAG_CLAMAV_TIMEOUT_SECONDS=10
AGENT_RAG_OCR_BACKEND=disabled
AGENT_RAG_OCR_ENDPOINT_URL=
AGENT_RAG_OCR_API_KEY=
AGENT_RAG_OCR_TIMEOUT_SECONDS=60
AGENT_RAG_OCR_MAX_RESPONSE_BYTES=20971520
# OCR 置信度低于该值的页面继续阻断，只保留为人工审核证据。
AGENT_RAG_PDF_MIN_OCR_CONFIDENCE=0.75

# Java 健身核心 Tool Gateway。签名 AgentContext 按用户请求提供；
# 此 Token 仅用于验证 Agent 服务自身身份。
AGENT_GATEWAY_BASE_URL=http://127.0.0.1:8081
AGENT_GATEWAY_INTERNAL_SERVICE_TOKEN=
GATEWAY_CONTEXT_SIGNING_SECRET=
GATEWAY_CONTEXT_SIGNING_ALGORITHM=HS256
GATEWAY_CONTEXT_SIGNING_KEY_ID=legacy
# 轮换期间的旧 kid -> secret，使用 JSON 注入；没有轮换时保持空对象。
GATEWAY_CONTEXT_SIGNING_KEY_RING={}
GATEWAY_CONTEXT_VERIFICATION_PUBLIC_KEY_RING={}
GATEWAY_CONTEXT_VERIFICATION_JWKS_URL=
# 生产环境必须使用认证服务的 HTTPS JWKS 地址；本地可为空并继续使用 HMAC。
GATEWAY_CONTEXT_VERIFICATION_JWKS_CACHE_SECONDS=300
GATEWAY_CONTEXT_VERIFICATION_JWKS_TIMEOUT_SECONDS=2
AGENT_GATEWAY_CONTEXT_MAX_TTL_SECONDS=300
AGENT_GATEWAY_TIMEOUT_SECONDS=5
AGENT_GATEWAY_MAX_RETRIES=2
AGENT_GATEWAY_RETRY_BACKOFF_SECONDS=0.1

# 真实经营冒烟联调为显式启用；AgentContext 必须由认证服务签发给组织管理员，
# 不要提交该值，也不要在 Shell 历史或日志中打印它。
AGENT_LIVE_API_URL=http://127.0.0.1:8090
AGENT_LIVE_TIMEOUT_SECONDS=90
