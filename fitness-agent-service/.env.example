# Copy to .env for local development. Never commit .env.
AGENT_ENVIRONMENT=local
AGENT_HOST=0.0.0.0
AGENT_PORT=8090
AGENT_SERVICE_NAME=fitness-agent-service
AGENT_LOG_LEVEL=INFO

# Agent persistence and checkpointing
AGENT_DATABASE_URL=postgresql+asyncpg://fitness_agent:fitness_agent@127.0.0.1:5433/fitness_agent
AGENT_REDIS_URL=redis://127.0.0.1:6380/0
AGENT_DB_POOL_SIZE=10
AGENT_DB_MAX_OVERFLOW=20

# LLM provider: use an OpenAI-compatible endpoint in each environment.
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# Embedding can use a separate OpenAI-compatible endpoint and model.
AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=

# Reranker uses a provider-specific HTTP endpoint; no local fallback is enabled.
AGENT_RERANKER_URL=
AGENT_RERANKER_API_KEY=
AGENT_RERANKER_MODEL=
AGENT_RERANKER_TIMEOUT_SECONDS=15

# Service-to-service authentication will be enforced by the Tool Gateway.
AGENT_INTERNAL_SERVICE_TOKEN=
